# Copy to .env and fill secrets. Never commit .env.
# chmod 600 .env on the VPS.

# ── Telegram ──
# Only the app container gets the bot token. The scraper runs without it and
# relays CRITICAL alerts through Redis (ops:critical).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Comma-separated numeric Telegram user ids for hidden admin commands
TELEGRAM_ADMIN_USER_IDS=
# Optional: forum topic id inside the admin group (see /get_topic_id)
# TELEGRAM_ADMIN_TOPIC_ID=
# Pin the live VIP counter box in the admin chat (bot must be group admin)
# VIP_COUNTER_PIN=false
# How often the app forwards scraper CRITICAL alerts (ms)
# ADMIN_RELAY_POLL_MS=60000
# Set true to never page Telegram (local scripts / CI). Auto-suppressed when
# DATABASE_URL is localhost outside Docker.
# ADMIN_ALERTS_DISABLED=false

# ── Database (Compose injects DATABASE_URL; keep these for postgres service) ──
POSTGRES_USER=johndoe
POSTGRES_PASSWORD=change_me_strong_pg
POSTGRES_DB=autobroker_db

# ── Redis (REQUIRED — compose will not start without it) ──
REDIS_PASSWORD=change_me_strong_redis

# ── App ──
PORT=3003
BACKFILL_NORMS=true
# On boot, refill versionTokens when [] but version has text (default true)
BACKFILL_VERSION_TOKENS=true
BRIGHTDATA_ENABLED=false
ADMIN_ALERT_COOLDOWN_MS=900000
AI_VIP_DAILY_MAX=40
AI_VIP_WEEKLY_MAX=280
AI_VIP_DB_LOOKUPS_MAX=3
AI_FREE_SEARCHES_MAX=3
TZ=Europe/Madrid
# Compose sets WORKER_MODE per service (app | scraper). Local monolith: all
# WORKER_MODE=all

# ── Engine / CV enrichment (version → engineNorm + powerHp; no re-scrape) ──
# Cron every 2h is hardcoded in the scraper/app. Manual: npm run enrich:engines
# ENRICH_LIMIT=20000

# ── Price FX (non-EUR countries → EUR; cron hourly on scraper) ──
# PRICE_FX_LIMIT=5000

# ── Stripe ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Soft launch: 3 links by VIP seat count — Tier1 0–200 · Tier2 201–500 · Tier3 501+
# (prices live in Stripe Dashboard, e.g. ~30 / ~60 / ~100 € — never hardcode in bot copy)
STRIPE_PAYMENT_LINK_TIER1=
STRIPE_PAYMENT_LINK_TIER2=
STRIPE_PAYMENT_LINK_TIER3=
STRIPE_PORTAL_LINK=

# ── AI Keys ──
OPENAI_API_KEY=
NVIDIA_API_KEY=
# ── Bright Data (only if BRIGHTDATA_ENABLED=true) ──
# PROXY_URL=
# BRIGHTDATA_API_KEY=
# BRIGHTDATA_ZONE=
# BRIGHTDATA_COUNTRY=es

# ── R2 backups ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2_ENDPOINT=
BACKUP_RETENTION_DAYS=7

# ── Notifications ──
# Default interval for new users / Reset (VIP can override via /schedule: 1–4h)
NOTIF_INTERVAL_HOURS=2
# How often the scheduler looks for users whose digest is due
NOTIF_TICK_MINUTES=5
# First digest after filter Done: random delay in this range (minutes)
NOTIF_FIRST_DELAY_MIN_MINUTES=5
NOTIF_FIRST_DELAY_MAX_MINUTES=15
# Max post-filter-change warmup digests per user per 24h (anti re-save farming)
NOTIF_WARMUP_MAX_PER_DAY=2
NOTIF_MAX_MESSAGES_PER_USER=1
NOTIF_MAX_PENDING_PER_USER=3
NOTIF_SEND_DELAY_MS=800
# Defaults for new users / Reset (Europe/Madrid). Per-user /schedule overrides these.
# Digests while START ≤ hour < END. Scrapers stay Mon–Fri separately.
NOTIF_WINDOW_START_HOUR=8
NOTIF_WINDOW_END_HOUR=21
# Hard floor — users cannot schedule outside this (leaves night free for cleanup/backup)
NOTIF_HARD_START_HOUR=7
NOTIF_HARD_END_HOUR=23

# ── Self-check thresholds (npm run verify:system) ──
# VERIFY_MIN_LISTINGS=200
# VERIFY_MAX_INGEST_AGE_HOURS=24
# VERIFY_MAX_BACKUP_AGE_HOURS=36

# ── Scrapers (optional) ──
# SCRAPER_PAGES=10
# SCRAPER_STEADY_PAGES=10
# CLICARS_MAX_PAGE=10
# CLICARS_PAGES_PER_RUN=10
# OY_PAGES_PER_RUN=10
# TP_PAGES_PER_RUN=5
# TP_MAX_DETAILS_PER_PAGE=8

# ── NPM docker network name ──
# NPM_NETWORK=nginx-proxy_default
